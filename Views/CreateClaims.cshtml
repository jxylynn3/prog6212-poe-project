@model ST10448420_CMCsystem.Models.ClaimCreateViewModel
@{
    ViewData["Title"] = "Create Claim";
}

<h2>Create Claim</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ClaimID" />
    <input type="hidden" asp-for="LecturerID" />

    <div class="mb-2">
        <label>Lecturer</label>
        <input class="form-control" value="@Model.LecturerName" readonly />
    </div>

    <div class="mb-2">
        <label asp-for="ClaimName"></label>
        <input asp-for="ClaimName" class="form-control" />
        <span asp-validation-for="ClaimName" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="ClaimDescription"></label>
        <textarea asp-for="ClaimDescription" class="form-control"></textarea>
    </div>

    <div class="mb-2">
        <label asp-for="ClaimDate"></label>
        <input asp-for="ClaimDate" class="form-control" type="date" />
    </div>

    <div class="row">
        <div class="col">
            <label asp-for="TotalHoursWorked"></label>
            <input asp-for="TotalHoursWorked" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col">
            <label asp-for="HourlyRate"></label>
            <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col">
            <label>Total Salary</label>
            <input class="form-control" value="@Model.TotalSalary" readonly />
        </div>
    </div>

    <div class="mb-2 mt-3">
        <label>Additional Notes</label>
        <textarea asp-for="AdditionalNotes" class="form-control"></textarea>
    </div>

    <hr />

    <h5>Supporting Documents</h5>
    <div class="mb-2">
        <input id="fileInput" type="file" />
        <button id="uploadBtn" type="button" class="btn btn-secondary">Upload Document</button>
    </div>

    <div id="uploadedList">
        <!-- uploaded filenames will appear here -->
    </div>

    <!-- container to hold hidden inputs for files (added when upload returns success) -->
    <div id="uploadedHiddenInputs"></div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Submit Claim</button>
        <a asp-controller="Dashboard" asp-action="LecturerDashboard" asp-route-id="@Model.LecturerID" class="btn btn-light">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.4.0/axios.min.js"></script>
    <script>
        document.getElementById('uploadBtn').addEventListener('click', async () => {
            const fileInput = document.getElementById('fileInput');
            if (!fileInput.files.length) { alert('Choose a file first'); return; }

            const file = fileInput.files[0];
            const form = new FormData();
            form.append('claimId', '@Model.ClaimID');
            form.append('file', file);

            try {
                // POST to UploadDocument
                const resp = await fetch('@Url.Action("UploadDocument", "Claims")', {
                    method: 'POST',
                    body: form
                });
                if (!resp.ok) {
                    const txt = await resp.text();
                    alert('Upload failed: ' + txt);
                    return;
                }
                const data = await resp.json();
                if (data.success) {
                    // show filename in list
                    const list = document.getElementById('uploadedList');
                    const p = document.createElement('p');
                    p.textContent = data.fileName;
                    list.appendChild(p);

                    // add hidden inputs so server knows which documents to link (if needed)
                    const container = document.getElementById('uploadedHiddenInputs');
                    // store documentId, fileName, filePath as hidden inputs (JSON string)
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'UploadedFiles.Index'; // will be used for binding to a list
                    hidden.value = Math.random().toString(36).substring(2,9);
                    container.appendChild(hidden);

                    // actual fields: DocumentID, FileName, FilePath using index mapping
                    const idx = document.querySelectorAll('#uploadedHiddenInputs input[type="hidden"]').length;
                    // create inputs expected by model binder (UploadedFiles[{i}].DocumentID etc.)
                    const dId = document.createElement('input');
                    dId.type = 'hidden'; dId.name = `UploadedFiles[${idx-1}].DocumentID`; dId.value = data.documentId;
                    const fName = document.createElement('input');
                    fName.type = 'hidden'; fName.name = `UploadedFiles[${idx-1}].FileName`; fName.value = data.fileName;
                    const fPath = document.createElement('input');
                    fPath.type = 'hidden'; fPath.name = `UploadedFiles[${idx-1}].FilePath`; fPath.value = data.filePath;

                    container.appendChild(dId);
                    container.appendChild(fName);
                    container.appendChild(fPath);

                    alert('Upload successful: ' + data.fileName);
                } else {
                    alert('Upload failed.');
                }
            } catch (ex) {
                console.error(ex);
                alert('Upload error: ' + ex.message);
            } finally {
                // clear file input
                fileInput.value = '';
            }
        });
    </script>

    @* client-side validation scripts *@
    <partial name="_ValidationScriptsPartial" />
}

