@model ST10448420_CMCsystem.Models.Claims
@{
    ViewData["Title"] = "Claim Details (Programme Coordinator)";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-body">
            <h3>@Model.ClaimName</h3>
            <p>@Model.ClaimDescription</p>

            <hr />
            <dl class="row">
                <dt class="col-sm-3">Lecturer</dt>
                <dd class="col-sm-9">@Model.Lecturer?.FirstName @Model.Lecturer?.LastName</dd>

                <dt class="col-sm-3">Claim Date</dt>
                <dd class="col-sm-9">@Model.ClaimDate.ToShortDateString()</dd>

                <dt class="col-sm-3">Total Hours</dt>
                <dd class="col-sm-9">@Model.TotalHoursWorked</dd>

                <dt class="col-sm-3">Hourly Rate</dt>
                <dd class="col-sm-9">R @Model.HourlyRate</dd>

                <dt class="col-sm-3">Total Salary</dt>
                <dd class="col-sm-9">R@(Model.TotalHoursWorked* Model.HourlyRate)</dd>

                <dt class="col-sm-3">Claim Status</dt>
                <dd class="col-sm-9">@Model.ClaimStatus</dd>
            </dl>

            <h5>Supporting Documents</h5>
            @if (Model.SupportingDocuments == null || !Model.SupportingDocuments.Any())
            {
                <p class="text-muted">No supporting documents.</p>
            }
            else
            {
                <ul>
                    @foreach (var doc in Model.SupportingDocuments)
                    {
                        <li><a href="@doc.FilePath" target="_blank">@doc.FileName</a></li>
                    }
                </ul>
            }

            <div class="mt-4 text-center">
                <form asp-controller="Claims" asp-action="ApproveClaimsPC" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.ClaimID" />
                    <button type="submit" class="btn btn-success me-2">Approve</button>
                </form>

                <form asp-controller="Claims" asp-action="RejectClaimsPC" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.ClaimID" />
                    <button type="submit" class="btn btn-danger">Reject</button>
                </form>

                <a asp-controller="Claims" asp-action="ReviewClaimsPC" class="btn btn-outline-secondary ms-3">Back</a>
            </div>
        </div>
    </div>
</div>

