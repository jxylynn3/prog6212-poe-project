@model IEnumerable<ST10448420_CMCsystem.Models.Claims>
@{
    ViewData["Title"] = "My Claims";
    var lecturerId = ViewBag.LecturerID ?? "L001";
}

<div class="container mt-4">
    <h2 class="mb-3">My Claims</h2>

    <div class="row">
        @foreach (var claim in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title">@claim.ClaimName</h5>
                        <p class="text-muted mb-2">@claim.ClaimDescription</p>
                        <p><strong>Status:</strong> @claim.ClaimStatus</p>
                        <p><strong>Date:</strong> @claim.ClaimDate.ToShortDateString()</p>
                        <p><strong>Amount:</strong> R@(claim.TotalHoursWorked* claim.HourlyRate)</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

    <div class="mt-4">
        <a asp-controller="Dashboard"
           asp-action="LecturerDashboard"
           asp-route-lecturerId="@lecturerId"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>


