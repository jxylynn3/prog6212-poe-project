@model ST10448420_CMCsystem.Models.ViewModels.HRUserManagementViewModel

<h2>Manage Users</h2>

<div class="mb-4 text-center">
    <a asp-controller="Dashboard"
       asp-action="HRDashboard"
       class="btn-sage-green">
        Back to Dashboard
    </a>
</div>
<h3>Lecturers</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Username</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Lecturers)
        {
            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.Username</td>
                <td>
                    <a asp-controller="HR" asp-action="UserDetails"
                       asp-route-role="Lecturer" asp-route-id="@user.LecturerID"
                       class="btn btn-sm"
                       style="background-color:#99686E; color:white; border:none;">
                        Details
                    </a>
                    <a asp-controller="HR" asp-action="EditUser"
                       asp-route-role="Lecturer" asp-route-id="@user.LecturerID"
                       class="btn btn-sm"
                       style="background-color:#DCAE96; color:white; border:none;">
                        Edit
                    </a>
                    <a asp-controller="HR" asp-action="DeleteUser"
                       asp-route-role="Lecturer" asp-route-id="@user.LecturerID"
                       class="btn btn-sm"
                       style="background-color:#EECB86; color:white; border:none;">
                        Delete
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>


