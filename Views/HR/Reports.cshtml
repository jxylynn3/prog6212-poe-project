@model ST10448420_CMCsystem.Models.ViewModels.ReportsViewModel

<h2>HR Claims Report Overview</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Status</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Pending</td>
            <td>@Model.Pending</td>
        </tr>
        <tr>
            <td>Up for Re-Review</td>
            <td>@Model.ReReview</td>
        </tr>
        <tr>
            <td>Approved</td>
            <td>@Model.Approved</td>
        </tr>
        <tr>
            <td>Rejected</td>
            <td>@Model.Rejected</td>
        </tr>
    </tbody>
</table>

<a class="btn btn-primary" asp-action="DownloadReport" asp-controller="HR">
    Download PDF Report
</a>
