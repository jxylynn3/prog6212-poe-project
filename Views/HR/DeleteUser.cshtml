@model dynamic

<h2>Confirm Delete</h2>

<p>Are you sure you want to delete @Model.FirstName @Model.LastName?</p>

<form method="post" asp-action="DeleteUserConfirmed">
    <input type="hidden" name="role" value="@ViewBag.Role" />
    <input type="hidden" name="id" value="@ViewBag.Id" />
    <button class="btn btn-danger">Delete</button>
    <a asp-action="ManageUsers" class="btn btn-secondary">Cancel</a>
</form>
