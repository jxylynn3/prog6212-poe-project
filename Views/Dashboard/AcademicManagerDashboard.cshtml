@model ST10448420_CMCsystem.Models.ViewModels.IClaimsDashboardViewModel

@{
    ViewData["Title"] = "Academic Manager Dashboard";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">📋 Claims Overview</h2>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs" id="claimsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                Pending Claims
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rereview-tab" data-bs-toggle="tab" data-bs-target="#rereview" type="button" role="tab">
                Re-Review
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                Approved Claims
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                Rejected Claims
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content mt-4" id="claimsTabsContent">

        <!-- Pending -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            @await Html.PartialAsync("_ClaimsGallery", Model.PendingClaims)
        </div>
        <!-- Re-Review -->
        <div class="tab-pane fade" id="rereview" role="tabpanel">
            @await Html.PartialAsync("_ClaimsGallery", Model.ReReviewClaims, new ViewDataDictionary(ViewData) { { "Role", "AcademicManager" } })
        </div>


        <!-- Approved -->
        <div class="tab-pane fade" id="approved" role="tabpanel">
            @await Html.PartialAsync("_ClaimsGallery", Model.ApprovedClaims)
        </div>

        <!-- Rejected -->
        <div class="tab-pane fade" id="rejected" role="tabpanel">
            @await Html.PartialAsync("_ClaimsGallery", Model.RejectedClaims)
        </div>
    </div>
</div>
